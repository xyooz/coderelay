{
  "name": "coderelay",
  "version": "0.1.0",
  "description": "Turn ChatGPT into a local coding agent with secure MCP access.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "coderelay": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --exclude tests/e2e/**",
    "test:e2e": "npm run build && vitest run tests/e2e",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm run build && node scripts/check-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "commander": "^14.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
